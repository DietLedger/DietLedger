# ── General ──────────────────────────────────────────────────────────
# Server port for Next.js frontend (default: 3000)
PORT=3000

# FDA FoodData Central API key
# Get a free key at: https://fdc.nal.usda.gov/api-key-signup.html
# DEMO_KEY is rate-limited to 30 req/hour; a real key gets 3,600 req/hour
FDA_API_KEY=DEMO_KEY

# ── Mode Selection ──────────────────────────────────────────────────
# Set to "true" or "1" for local-only mode (IndexedDB + SQLite, no Go server)
# Leave unset or "false" for server mode (Go API + PostgreSQL)
# NEXT_PUBLIC_DIETLEDGER_LOCAL_ONLY=false

# ── Go API Server (server mode only) ────────────────────────────────
# The Go API is reached via the Next.js middleware proxy over the Docker
# network. You do NOT need to set a browser-visible API URL.
# API_PORT=8080

# ── Database ────────────────────────────────────────────────────────
# Database driver: "postgres" (server mode) or "sqlite" (development)
DB_DRIVER=postgres

# PostgreSQL connection string (server mode)
# DATABASE_URL=postgres://dietledger:dietledger@localhost:5432/dietledger?sslmode=disable

# SQLite database path (when DB_DRIVER=sqlite, used by Go server for tests)
# DB_PATH=./sync-server.db

# ── PostgreSQL (Docker) ─────────────────────────────────────────────
# These are used by docker-compose.yml
# POSTGRES_DB=dietledger
# POSTGRES_USER=dietledger
# POSTGRES_PASSWORD=dietledger

# ── Go API Server Config ────────────────────────────────────────────
# CORS allowed origin (comma-separated, or * for any)
# CORS_ORIGIN=http://localhost:3000

# Max request body size in MB (default: 10)
# MAX_BODY_MB=10

# JWT signing secret for HMAC-S256 (server mode). If not set, a random
# secret is generated on each restart, invalidating all existing tokens.
# Set this to a stable value in production.
# HMAC_SECRET=change-me-to-a-long-random-string

# ── Local Mode Only (SQLite via Prisma) ─────────────────────────────
# Used by Next.js when DIETLEDGER_LOCAL_ONLY=true
# DATABASE_URL=file:/app/db/custom.db
