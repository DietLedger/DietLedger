# ── Docker Deployment ──────────────────────────────────────────────
# Copy this file to .env before running docker compose.

# Frontend port
PORT=3000

# API server port
API_PORT=8080

# ── PostgreSQL ─────────────────────────────────────────────────────
POSTGRES_DB=dietledger
POSTGRES_USER=dietledger
POSTGRES_PASSWORD=dietledger

# ── Go API Server ─────────────────────────────────────────────────
# JWT signing secret. Set to a stable value in production.
# If unset, a random secret is generated each restart (tokens won't survive restarts).
HMAC_SECRET=change-me-to-a-long-random-string

# CORS allowed origins (comma-separated)
CORS_ORIGIN=http://localhost:3000

# FDA FoodData Central API key
# Get a free key at: https://fdc.nal.usda.gov/api-key-signup.html
FDA_API_KEY=DEMO_KEY

# ── Optional ──────────────────────────────────────────────────────
# Public API URL for browser requests. If unset, the frontend proxies /api/* to the Go API.
# NEXT_PUBLIC_API_URL=http://localhost:8080
