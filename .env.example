# Select a published release tag for the source Compose definition. Release
# assets pin image digests instead. For a local image override use local.
DIETLEDGER_VERSION=

# Supply five independent cryptographically secure random values, each 32
# random bytes encoded as 64 hex (lowercase) characters. Do not reuse values. Keep this
# file restricted; never commit or distribute it. Preserve an encrypted offline
# backup of all five values with the database backup. There is no automatic
# generation or rotation. HMAC_SECRET is needed to decrypt provider settings.
# Do not replace initialized database passwords or HMAC to recover lost state.
POSTGRES_PASSWORD=
MIGRATION_DB_PASSWORD=
API_DB_PASSWORD=
HMAC_SECRET=
SETUP_CLAIM_SECRET=

# Loopback HTTP only: wider access requires a trusted HTTPS ingress, secure
# browser context, explicit bind and exact browser origin; set the flag false.
BIND_ADDRESS=127.0.0.1
PORT=3000
CORS_ORIGIN=http://localhost:3000
AUTH_ALLOW_INSECURE_LOOPBACK=true

# Provider API keys are entered separately in per-user Settings.
