# DietLedger Docker Deployment Configuration
# This file is read by docker-compose.yml

# ── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_DB=dietledger
POSTGRES_USER=dietledger
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ── Ports ────────────────────────────────────────────────────────
# Frontend (Next.js) port
PORT=3000
# API (Go server) port
API_PORT=8080

# ── Go API Server ────────────────────────────────────────────────
# JWT signing secret — set to a long random string in production
# If unset, a random secret is generated each restart (tokens won't survive)
HMAC_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# CORS allowed origins (comma-separated)
CORS_ORIGIN=http://localhost:3000

# NOTE: The USDA FoodData Central API key is configured per-user in the app
# Settings (stored encrypted in the database). There is no server-level env var.

# Max request body size in MB (default: 10)
# MAX_BODY_MB=10

# RSA private key PEM file path for JWT signing (optional, HMAC used if unset)
# JWT_SIGNING_KEY_PATH=/path/to/private.pem

# Public API URL for browser (optional — frontend proxies /api/* by default)
# NEXT_PUBLIC_API_URL=http://localhost:8080
