generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Recipe {
  id          String       @id @default(cuid())
  name        String
  servings    Int          @default(1)
  instructions String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  ingredients Ingredient[]
}

model Ingredient {
  id            String   @id @default(cuid())
  recipeId      String
  fdcId         Int
  name          String
  amount        Float
  unit          String
  calories      Float    @default(0)
  totalFat      Float    @default(0)
  saturatedFat  Float    @default(0)
  transFat      Float    @default(0)
  cholesterol   Float    @default(0)
  sodium        Float    @default(0)
  totalCarbs    Float    @default(0)
  dietaryFiber  Float    @default(0)
  totalSugars   Float    @default(0)
  addedSugars   Float    @default(0)
  protein       Float    @default(0)
  vitaminD      Float    @default(0)
  calcium       Float    @default(0)
  iron          Float    @default(0)
  potassium     Float    @default(0)
  recipe        Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model FoodItem {
  id              Int      @id @default(autoincrement())
  fdcId           Int      @unique
  description     String
  dataType        String
  brandOwner      String?
  gtinUpc         String?
  servingSize     Float    @default(100)
  servingSizeUnit String   @default("g")

  calories      Float @default(0)
  totalFat      Float @default(0)
  saturatedFat  Float @default(0)
  transFat      Float @default(0)
  cholesterol   Float @default(0)
  sodium        Float @default(0)
  totalCarbs    Float @default(0)
  dietaryFiber  Float @default(0)
  totalSugars   Float @default(0)
  addedSugars   Float @default(0)
  protein       Float @default(0)
  vitaminD      Float @default(0)
  calcium       Float @default(0)
  iron          Float @default(0)
  potassium     Float @default(0)

  source    String   @default("usda")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([description])
  @@index([dataType])
  @@index([gtinUpc])
}

model SeedJob {
  id           Int      @id @default(autoincrement())
  dataType     String
  releaseDate  String
  fileName     String
  recordCount  Int      @default(0)
  status       String   @default("pending")
  progress     Float    @default(0)
  error        String?
  checkpoint   String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
}

model RecipeBook {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  coverColor  String    @default("#059669")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  chapters    Chapter[]

  @@index([updatedAt])
}

model Chapter {
  id             String         @id @default(cuid())
  bookId         String
  title          String
  position       Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  book           RecipeBook     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterRecipes ChapterRecipe[]
  chapterPages   ChapterPage[]

  @@index([bookId])
  @@index([position])
}

model ChapterRecipe {
  id        String  @id @default(cuid())
  chapterId String
  recipeId  String
  position  Int     @default(0)
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, recipeId])
  @@index([chapterId])
  @@index([recipeId])
}

model ChapterPage {
  id        String   @id @default(cuid())
  chapterId String
  title     String
  content   String   @default("")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
  @@index([position])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("CategoryTree")

  @@index([parentId])
}

model RecipeCategory {
  id         String   @id @default(cuid())
  recipeId   String
  categoryId String
  createdAt  DateTime @default(now())

  @@unique([recipeId, categoryId])
  @@index([recipeId])
  @@index([categoryId])
}

enum Sex {
  male
  female
}

enum ActivityLevel {
  sedentary
  light
  moderate
  active
  veryActive
}

enum MealSlot {
  morning
  midMorning
  noon
  afternoon
  evening
  snack
}

enum FoodSourceType {
  recipe
  customFood
  manual
}

model PersonProfile {
  id            String       @id
  name          String
  sex           Sex
  birthDate     String?
  heightCm      Float?
  activityLevel ActivityLevel @default(moderate)
  goalWeightKg  Float?
  goalDate      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  foodLogEntries FoodLogEntry[]
  weightEntries  WeightEntry[]

  @@index([updatedAt])
}

model FoodLogEntry {
  id          String        @id
  profileId   String
  date        String
  mealSlot    MealSlot
  sourceType  FoodSourceType
  sourceId    String?
  name        String
  servings    Float         @default(1)
  calories    Float         @default(0)
  totalFat    Float         @default(0)
  saturatedFat Float        @default(0)
  transFat    Float         @default(0)
  cholesterol Float         @default(0)
  sodium      Float         @default(0)
  totalCarbs  Float         @default(0)
  dietaryFiber Float        @default(0)
  totalSugars Float         @default(0)
  addedSugars Float         @default(0)
  protein     Float         @default(0)
  vitaminD    Float         @default(0)
  calcium     Float         @default(0)
  iron        Float         @default(0)
  potassium   Float         @default(0)
  lastSyncedAt String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  profile     PersonProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([date])
  @@index([profileId, date])
  @@index([sourceType, sourceId])
}

model WeightEntry {
  id           String       @id
  profileId    String
  date         String
  weightKg     Float
  notes        String?
  lastSyncedAt String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  profile      PersonProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, date])
  @@index([profileId])
  @@index([date])
}
